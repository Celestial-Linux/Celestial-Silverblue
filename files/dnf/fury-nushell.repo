# Gemfury publishes unsigned nushell RPMs, so gpgcheck cannot be enabled.
# The allowlist keeps this repo from providing anything else, and the
# supply-chain audit tracks each package checksum.
[gemfury-nushell]
name=Gemfury Nushell Repo
baseurl=https://yum.fury.io/nushell/
enabled=1
gpgcheck=0
gpgkey=https://yum.fury.io/nushell/gpg.key
includepkgs=nushell
