# Runtime dependency of caelestia-shell, declared explicitly for the same reason as quickshell.
[copr:copr.fedorainfracloud.org:brycensranch:gpu-screen-recorder-git]
name=Copr repo for gpu-screen-recorder-git owned by brycensranch
baseurl=https://download.copr.fedorainfracloud.org/results/brycensranch/gpu-screen-recorder-git/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
